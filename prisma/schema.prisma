// Gestionale Stalla Ciravolo – schema database
// Database: SQLite (un file dentro la cartella data/, nessun server esterno).
// Per passare a MySQL/PostgreSQL basta cambiare `provider` e rigenerare le migrazioni.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── UTENTI E SESSIONI ─────────────────────────────

enum Role {
  ADMIN
  DIRETTORE
  GESTORE
  DIPENDENTE
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  displayName   String
  passwordHash  String
  role          Role      @default(DIPENDENTE)
  active        Boolean   @default(true)
  /// Percentuali stipendio personali (null = usa quelle globali)
  pctStable     Decimal?
  pctGov        Decimal?
  pctItems      Decimal?
  notes         String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  capturedHorses    Horse[]          @relation("HorseCapturedBy")
  sales             Sale[]           @relation("SaleSeller")
  voidedSales       Sale[]           @relation("SaleVoidedBy")
  spawns            Spawn[]          @relation("SpawnCreatedBy")
  spawnsUpdated     Spawn[]          @relation("SpawnUpdatedBy")
  reservations      Reservation[]    @relation("ReservationAssigned")
  reservationsMade  Reservation[]    @relation("ReservationCreatedBy")
  reservationsEdit  Reservation[]    @relation("ReservationUpdatedBy")
  payrollEntries    PayrollEntry[]   @relation("PayrollUser")
  payrollPaid       PayrollEntry[]   @relation("PayrollPaidBy")
  payments          Payment[]        @relation("PaymentUser")
  paymentsRecorded  Payment[]        @relation("PaymentRecordedBy")
  priceChanges      PriceHistory[]
  auditLogs         AuditLog[]
  ownedHorses       Horse[]          @relation("HorseOwner")
  transfersFrom     HorseTransfer[]  @relation("TransferFrom")
  transfersTo       HorseTransfer[]  @relation("TransferTo")
  transfersMade     HorseTransfer[]  @relation("TransferBy")
  itemSales         ItemSale[]       @relation("ItemSaleSeller")
  itemSalesVoided   ItemSale[]       @relation("ItemSaleVoidedBy")
  shopNotes         ShopNote[]       @relation("ShopNoteBy")
  shopNotesHandled  ShopNote[]       @relation("ShopNoteHandledBy")
  reimbursements    Reimbursement[]  @relation("ReimbUser")
  reimbHandled      Reimbursement[]  @relation("ReimbHandledBy")
}

model Session {
  id        String   @id // hash SHA-256 del token
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
}

// ───────────────────────────── CATALOGO ─────────────────────────────

model Breed {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  /// Nome come scritto nel file Excel originale
  originalName String?
  description  String?
  /// Razza personalizzata / da mod (non presente in RDR2 originale)
  isCustom     Boolean  @default(false)
  sortOrder    Int      @default(0)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coats        Coat[]
  horses       Horse[]
  spawns       Spawn[]
  reservations Reservation[]
}

model Coat {
  id           Int      @id @default(autoincrement())
  breedId      Int
  breed        Breed    @relation(fields: [breedId], references: [id], onDelete: Restrict)
  name         String
  originalName String?
  description  String?
  /// Percorso relativo nella cartella upload (es. "coats/arabian-black.webp")
  imagePath    String?

  // Prezzi (colonne del LISTINO). Tutti modificabili dall'admin.
  /// LISTINO GOV – prezzo di acquisto al blip (informativo)
  govListPrice    Decimal?
  /// 5-10 ANNI – prezzo base senza addestramento
  basePriceA      Decimal?
  /// 11-15 ANNI – prezzo base senza addestramento
  basePriceB      Decimal?
  /// ADDEST. – costo addestramento
  trainingPrice   Decimal?
  /// TOT 5-10 ANNI – prezzo di vendita di riferimento fascia A
  salePriceA      Decimal?
  /// TOT 11-16 ANNI – prezzo di vendita di riferimento fascia B
  salePriceB      Decimal?
  /// GOVERNO – prezzo di vendita al blip del Governo
  governmentPrice Decimal?

  notes     String?
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stats        CoatStat[]
  horses       Horse[]
  spawns       Spawn[]
  reservations Reservation[]
  priceHistory PriceHistory[]

  @@unique([breedId, name])
}

model StatDefinition {
  id        Int        @id @default(autoincrement())
  key       String     @unique
  /// Etichetta visualizzata (es. "VELOC."), modificabile dall'admin
  label     String
  sortOrder Int        @default(0)
  values    CoatStat[]
}

model CoatStat {
  coatId Int
  statId Int
  coat   Coat           @relation(fields: [coatId], references: [id], onDelete: Cascade)
  stat   StatDefinition @relation(fields: [statId], references: [id], onDelete: Cascade)
  value  Decimal?

  @@id([coatId, statId])
}

model PriceHistory {
  id          Int      @id @default(autoincrement())
  coatId      Int
  coat        Coat     @relation(fields: [coatId], references: [id], onDelete: Cascade)
  field       String
  oldValue    Decimal?
  newValue    Decimal?
  changedById Int?
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime @default(now())

  @@index([coatId])
}

// ───────────────────────────── CAVALLI (CATTURE + STALLA) ─────────────────────────────

enum Sex {
  MASCHIO
  FEMMINA
}

enum HorseStatus {
  /// Depositato e disponibile in stalla
  IN_STALLA
  /// Venduto dalla stalla
  VENDUTO
  /// Venduto direttamente al blip del Governo (mai entrato in stalla)
  VENDUTO_GOVERNO
  /// Uscito dalla stalla per altri motivi (morto, liberato, trasferito...)
  RIMOSSO
}

/// Ogni cavallo catturato. È contemporaneamente lo storico catture
/// e l'inventario della stalla (status = IN_STALLA).
model Horse {
  id        Int         @id @default(autoincrement())
  breedId   Int
  breed     Breed       @relation(fields: [breedId], references: [id], onDelete: Restrict)
  coatId    Int
  coat      Coat        @relation(fields: [coatId], references: [id], onDelete: Restrict)
  /// Facoltativi per le vendite immediate al blip del Governo
  sex       Sex?
  plate     String?
  status    HorseStatus
  /// Condizione del cavallo (es. Sano, Ferito...)
  condition String?
  notes     String?

  /// Età maturata fino a ageCheckpointAt (anni, con decimali)
  ageBase         Decimal?
  /// Da questo istante l'età continua ad avanzare automaticamente
  ageCheckpointAt DateTime
  /// Età dichiarata alla cattura (storico, non cambia)
  initialAge      Decimal?

  /// Stalliere che ha in carico il cavallo (l'unico che può venderlo). Cambia con i trasferimenti.
  ownerId Int
  owner   User @relation("HorseOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  /// Gravidanza: data dell'accoppiamento e data prevista per il parto (modificabile)
  pregnantSince  DateTime?
  pregnancyDueAt DateTime?

  capturedById Int
  capturedBy   User     @relation("HorseCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)
  capturedAt   DateTime @default(now())
  /// Valorizzato se il cavallo è stato depositato in stalla
  depositedAt  DateTime?
  exitedAt     DateTime?
  exitReason   String?

  /// Chiave anti doppio invio del modulo
  requestId String?  @unique
  /// Versione per il blocco ottimistico
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
  transfers HorseTransfer[]

  @@index([status])
  @@index([ownerId])
  @@index([capturedById])
  @@index([capturedAt])
  @@index([plate])
}

/// Passaggio gratuito di un cavallo da uno stalliere a un altro
model HorseTransfer {
  id         Int      @id @default(autoincrement())
  horseId    Int
  horse      Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  fromUserId Int
  fromUser   User     @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   Int
  toUser     User     @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  byUserId   Int
  byUser     User     @relation("TransferBy", fields: [byUserId], references: [id], onDelete: Cascade)
  notes      String?
  createdAt  DateTime @default(now())

  @@index([horseId])
}

// ───────────────────────────── VENDITE ─────────────────────────────

enum SaleType {
  STALLA
  GOVERNO
}

enum DiscountType {
  PERCENTUALE
  IMPORTO
}

/// Vendita: conserva una fotografia dei dati al momento della transazione.
model Sale {
  id      Int      @id @default(autoincrement())
  horseId Int
  horse   Horse    @relation(fields: [horseId], references: [id], onDelete: Restrict)
  type    SaleType

  // Fotografia anagrafica
  breedName String
  coatName  String
  sex       Sex?
  plate     String?
  ageAtSale Decimal?

  // Fotografia economica
  /// Fascia di prezzo applicata (es. "5-10", "11-16", "Libero", "Governo")
  priceBracket  String
  listPrice     Decimal?
  discountType  DiscountType?
  discountValue Decimal?
  finalPrice    Decimal

  sellerId   Int
  seller     User    @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  sellerName String
  buyerName  String?
  notes      String?
  soldAt     DateTime @default(now())

  /// Le vendite non si cancellano: si annullano
  voided       Boolean   @default(false)
  voidedAt     DateTime?
  voidedById   Int?
  voidedBy     User?     @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([soldAt])
  @@index([sellerId, soldAt])
  @@index([type])
  @@index([horseId])
}

// ───────────────────────────── MAPPA SPAWN ─────────────────────────────

enum SpawnKind {
  /// Avvistamento certo di un cavallo (icona ferro di cavallo colorata per razza)
  CAVALLO
  /// Possibile cavallo da verificare (icona "?")
  POSSIBILE
  /// Nota libera sulla mappa (segnaposto colorato)
  NOTA
}

model Spawn {
  id          Int       @id @default(autoincrement())
  kind        SpawnKind @default(CAVALLO)
  /// Titolo della nota (per le note libere)
  title       String?
  /// Colore del segnaposto delle note (#rrggbb)
  color       String?
  /// Coordinate in pixel sull'immagine della mappa
  x           Float
  y           Float
  breedId     Int?
  breed       Breed?   @relation(fields: [breedId], references: [id], onDelete: SetNull)
  coatId      Int?
  coat        Coat?    @relation(fields: [coatId], references: [id], onDelete: SetNull)
  location    String?
  description String?
  notes       String?
  createdById Int
  createdBy   User     @relation("SpawnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById Int?
  updatedBy   User?    @relation("SpawnUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────── NOTE / PRENOTAZIONI ─────────────────────────────

enum ReservationStatus {
  DA_CATTURARE
  PRENOTATO
  VENDIBILE_DA_TUTTI
  AFFARE_CHIUSO
  ANNULLATO
}

model Reservation {
  id           Int               @id @default(autoincrement())
  title        String?
  customerName String?
  missiva      String?
  breedId      Int?
  breed        Breed?            @relation(fields: [breedId], references: [id], onDelete: SetNull)
  coatId       Int?
  coat         Coat?             @relation(fields: [coatId], references: [id], onDelete: SetNull)
  plate        String?
  price        Decimal?
  deposit      Decimal?
  deliveryDate DateTime?
  status       ReservationStatus @default(PRENOTATO)
  assignedToId Int?
  assignedTo   User?             @relation("ReservationAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        String?
  createdById  Int
  createdBy    User              @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById  Int?
  updatedBy    User?             @relation("ReservationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
}

// ───────────────────────────── STIPENDI ─────────────────────────────

enum PayrollStatus {
  DA_PAGARE
  PARZIALE
  PAGATO
}

/// Registro stipendio di una settimana per un dipendente.
/// Le righe vengono create quando si paga/modifica/annota una settimana;
/// le settimane senza riga sono calcolate al volo dalle vendite.
model PayrollEntry {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation("PayrollUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Lunedì 00:00 (fuso orario della stalla) della settimana
  weekStart      DateTime
  status         PayrollStatus @default(DA_PAGARE)
  /// Fotografia dei totali al primo pagamento
  stableTotal    Decimal?
  govTotal       Decimal?
  itemsTotal     Decimal?
  pctStable      Decimal?
  pctGov         Decimal?
  pctItems       Decimal?
  computedAmount Decimal?
  /// Importo dovuto modificato manualmente (sostituisce il calcolo)
  amountOverride Decimal?
  /// Totale effettivamente pagato (somma dei pagamenti, può superare il dovuto come incentivo)
  paidAmount     Decimal       @default(0)
  paidAt         DateTime?
  paidById       Int?
  paidBy         User?         @relation("PayrollPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments Payment[]

  @@unique([userId, weekStart])
}

enum PaymentAction {
  PAGATO
  ANNULLATO
}

/// Storico pagamenti: ogni pagamento (o annullamento) è una riga permanente.
model Payment {
  id             Int           @id @default(autoincrement())
  payrollEntryId Int
  payrollEntry   PayrollEntry  @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  userId         Int
  user           User          @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)
  weekStart      DateTime
  /// Quanto spettava al momento del pagamento
  dueAmount      Decimal       @default(0)
  /// Quanto è stato pagato con questa operazione
  amount         Decimal
  action         PaymentAction
  recordedById   Int?
  recordedBy     User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

// ───────────────────────────── BOTTEGA (oggetti, materie prime, fornitori) ─────────────────────────────

enum ShopItemKind {
  /// Oggetto venduto dalla stalla
  VENDITA
  /// Materia prima / oggetto acquistato dalla stalla
  MATERIA_PRIMA
}

model ShopItem {
  id        Int          @id @default(autoincrement())
  kind      ShopItemKind
  name      String
  /// Gruppo (es. Cavalli, Carri, Stalla)
  group     String?
  price     Decimal?
  /// Valore tra parentesi nel file o note sul prezzo (es. "5 Fenix")
  priceNote String?
  notes     String?
  sortOrder Int          @default(0)
  archived  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  saleLines ItemSaleLine[]
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  activity    String?
  goods       String?
  missiva     String?
  /// Contrassegnato con * nel file originale
  starred     Boolean  @default(false)
  notes       String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reimbursements Reimbursement[]
}

enum ShopNoteType {
  NUOVO_FORNITORE
  MODIFICA_PROPOSTA
  NOTA
}

enum ShopNoteStatus {
  APERTA
  ACCOLTA
  RESPINTA
}

/// Proposte e note degli utenti sulla bottega (gestite da admin/direttore/gestore)
model ShopNote {
  id          Int            @id @default(autoincrement())
  type        ShopNoteType
  text        String
  status      ShopNoteStatus @default(APERTA)
  response    String?
  createdById Int
  createdBy   User           @relation("ShopNoteBy", fields: [createdById], references: [id], onDelete: Cascade)
  handledById Int?
  handledBy   User?          @relation("ShopNoteHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  createdAt   DateTime       @default(now())
}

enum ReimbursementStatus {
  RICHIESTO
  APPROVATO
  PAGATO
  RESPINTO
}

/// Rimborso dovuto a un utente per merce acquistata di tasca propria
model Reimbursement {
  id           Int                 @id @default(autoincrement())
  userId       Int
  user         User                @relation("ReimbUser", fields: [userId], references: [id], onDelete: Cascade)
  supplierId   Int?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String?
  description  String
  amount       Decimal
  status       ReimbursementStatus @default(RICHIESTO)
  response     String?
  handledById  Int?
  handledBy    User?               @relation("ReimbHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt    DateTime?
  paidAt       DateTime?
  createdAt    DateTime            @default(now())

  @@index([userId])
  @@index([status])
}

/// Vendita di oggetti della bottega (fotografia di nomi e prezzi)
model ItemSale {
  id         Int       @id @default(autoincrement())
  sellerId   Int
  seller     User      @relation("ItemSaleSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerName String
  buyerName  String?
  total      Decimal
  notes      String?
  soldAt     DateTime  @default(now())
  requestId  String?   @unique
  voided     Boolean   @default(false)
  voidedAt   DateTime?
  voidedById Int?
  voidedBy   User?     @relation("ItemSaleVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?
  createdAt  DateTime  @default(now())

  lines ItemSaleLine[]

  @@index([soldAt])
  @@index([sellerId, soldAt])
}

model ItemSaleLine {
  id         Int       @id @default(autoincrement())
  saleId     Int
  sale       ItemSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId     Int?
  item       ShopItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName   String
  quantity   Int
  unitPrice  Decimal
  lineTotal  Decimal
}

// ───────────────────────────── IMPOSTAZIONI E AUDIT ─────────────────────────────

model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String?
  action    String
  entity    String
  entityId  String?
  summary   String
  details   String? // JSON con prima/dopo
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}
