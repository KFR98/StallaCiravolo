# ── Database (MySQL/MariaDB). In Pterodactyl: scheda "Databases" del server.
# Caratteri speciali nella password vanno codificati (es. @ → %40).
DATABASE_URL="mysql://utente:password@127.0.0.1:3306/stalla"

# ── Indirizzo pubblico del gestionale (usato per i cookie sicuri)
APP_URL="https://stalla.tuodominio.it"
# true se il sito è servito in HTTPS (consigliato)
COOKIE_SECURE="true"
# Solo se il proxy non inoltra l'host originale: dominio pubblico consentito per i moduli
# ALLOWED_ORIGINS="stalla.tuodominio.it"

# ── Primo avvio: account amministratore (se non esiste ancora un admin)
ADMIN_USERNAME="admin"
# Se vuoto viene generata una password casuale e stampata in console
ADMIN_PASSWORD=""

# ── Cartelle dati (persistenti)
UPLOAD_DIR="./data/uploads"
BACKUP_DIR="./data/backups"
# Backup automatici da conservare
BACKUP_KEEP="14"
# false per disattivare il backup automatico giornaliero
BACKUP_AUTO="true"
# false per non importare automaticamente le nuove foto di Cavalli/ all'avvio
IMAGES_AUTO_IMPORT="true"

# ── Fuso orario per giornate e settimane (stipendi da lunedì a domenica)
TZ_STALLA="Europe/Rome"

# ── Porta (in Pterodactyl viene usata SERVER_PORT automaticamente)
PORT="3000"
